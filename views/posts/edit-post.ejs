<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<div class="layout">

    <%- include("../partials/sidebar") %>

    <main class="main-content">

        <div class="page-title">

            <p class="eyebrow">EDIT POST</p>

            <h1>Update your story</h1>

        </div>


        <form
            action="/posts/<%= post._id %>/edit"
            method="POST"
            class="create-post-form"
        >

            <div class="form-group">

                <label>Caption</label>

                <textarea
                    name="caption"
                    maxlength="1000"
                ><%= post.caption %></textarea>

            </div>


            <div class="form-group">

                <label>Image URL</label>

                <input
                    type="url"
                    name="image"
                    value="<%= post.image %>"
                >

            </div>


            <button
                type="submit"
                class="publish-btn"
            >
                <i class="fa-solid fa-check"></i>
                Update Post
            </button>

        </form>

    </main>

</div>

<%- include("../partials/footer") %>